# ICMP ping toi victim
alert icmp any any -> $HOME_NET any (msg:"LAB T1018 - ICMP echo request toi Victim"; itype:8; sid:1000001; rev:1;)

# T1046 nhieu ket noi syn toi cac cong khac nhau trong thoi gian ngan (network service discovery)
alert tcp any any -> $HOME_NET any (msg:"LAB T1046 - Nghi ngo quet cong TCP"; flags:S; threshold:type both, track by_src, count 20, seconds 10; sid:1000002; rev:1;)

# T1110 nhieu lan bat tay SSH tu mot nguon (Brute Force)
alert tcp any any -> $HOME_NET 22 (msg:"LAB T1110 - Nghi ngo brute force SSH"; flags:S; threshold:type both, track by_src, count 10, seconds 30; sid:1000003; rev:1;)
