<!-- SOC Lab - Custom rules - Ngay 6 -->
<!-- Dai ID danh cho nguoi dung: 100000 - 120000 -->

<group name="soc_lab,suricata,">

  <!-- ===== Tang 1: Trinh sat ===== -->
  <rule id="100101" level="7">
    <if_sid>86601</if_sid>
    <field name="alert.signature">LAB T1018</field>
    <description>SOC Lab: Trinh sat ha tang bang ICMP tu $(src_ip)</description>
    <mitre>
      <id>T1018</id>
    </mitre>
    <group>recon,discovery,</group>
  </rule>

  <!-- ===== Tang 2: Quet dich vu ===== -->
  <rule id="100102" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature">LAB T1046</field>
    <description>SOC Lab: Quet cong TCP hang loat tu $(src_ip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,discovery,scan,</group>
  </rule>

  <!-- ===== Tang 3: Brute force nhin tu tang mang (NIDS) ===== -->
  <rule id="100103" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature">LAB T1110</field>
    <description>SOC Lab: NIDS phat hien brute force SSH tu $(src_ip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,bruteforce,</group>
  </rule>

</group>


<group name="soc_lab,syslog,sshd,">

  <!-- ===== Tang 3b: Brute force SSH - ke thua rule brute force co san cua Wazuh ===== -->
  <rule id="100110" level="12">
    <if_sid>5712,5720,5763</if_sid>
    <description>SOC Lab: Brute force SSH (nhieu lan dang nhap that bai) tu $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,bruteforce,</group>
  </rule>

  <!-- ===== Tang 4: Xam nhap thanh cong ngay sau brute force - muc cao nhat ===== -->
  <rule id="100111" level="14" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>100110</if_matched_sid>
    <same_source_ip />
    <description>SOC Lab: DANG NHAP SSH THANH CONG ngay sau chuoi brute force tu $(srcip) - nghi ngo chiem dung tai khoan</description>
    <mitre>
      <id>T1078</id>
      <id>T1021.004</id>
    </mitre>
    <group>authentication_success,intrusion,</group>
  </rule>

</group>

<group name="soc_lab,web,c2,">
